{
  "displayName": "Azharna backend errors",
  "combiner": "OR",
  "enabled": true,
  "conditions": [
    {
      "displayName": "Cloud Run or Functions error",
      "conditionMatchedLog": {
        "filter": "resource.labels.project_id=\"azharna-production\" AND (resource.type=\"cloud_run_revision\" OR resource.type=\"cloud_function\") AND severity>=ERROR"
      }
    }
  ],
  "alertStrategy": {
    "notificationRateLimit": {"period": "900s"},
    "autoClose": "86400s"
  },
  "notificationChannels": []
}
