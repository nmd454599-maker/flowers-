{
  "hosting": {
    "site": "azharna-catalog-preview",
    "public": "build/iphone_preview",
    "ignore": ["firebase.preview.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {"key": "Access-Control-Allow-Origin", "value": "*"},
          {"key": "Cache-Control", "value": "public, max-age=3600"}
        ]
      },
      {
        "source": "/index.html",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      }
    ]
  }
}
